# All defaults are local and use synthetic data. Copy to .env; never commit it.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/opentesoro.sqlite
OPENTESORO_DEMO=true
# Required if binding beyond loopback. Generate: openssl rand -hex 32
# OPENTESORO_API_TOKEN=
# OPENTESORO_READ_ONLY_TOKEN=
# ALLOWED_ORIGINS=https://treasury.example.com
# Optional current Agicap Public API credentials (NOT your login password)
# AGICAP_CLIENT_ID=
# AGICAP_CLIENT_SECRET=
