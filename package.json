{
  "name": "opentesoro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun apps/server/src/index.ts",
    "build": "bun run --cwd apps/web build && bun build apps/server/src/index.ts --target=bun --outdir=dist/server",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "seed": "bun apps/server/src/seed.ts",
    "benchmark": "bun packages/engine/benchmark.ts",
    "test:e2e": "bunx playwright test",
    "benchmark:api": "bun scripts/benchmark-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:backup": "bun scripts/verify-backup.ts",
    "licenses:generate": "bun scripts/licenses.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "description": "Standalone treasury and cash-flow planning for Italian tour operators"
}
