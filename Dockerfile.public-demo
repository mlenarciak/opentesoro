FROM oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY apps/server/package.json ./apps/server/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/engine/package.json ./packages/engine/package.json
COPY packages/sdk/package.json ./packages/sdk/package.json
COPY packages/agicap/package.json ./packages/agicap/package.json
RUN bun install --frozen-lockfile
COPY apps/server/src ./apps/server/src
COPY apps/web ./apps/web
COPY packages/engine/src ./packages/engine/src
COPY packages/sdk/src ./packages/sdk/src
COPY packages/agicap/src ./packages/agicap/src
RUN bun run --cwd apps/web build && bun build apps/server/src/public-demo-index.ts --target=bun --outfile=dist/public-demo.js

FROM oven/bun:1.3.13-slim@sha256:7e8ed3961db1cdedf17d516dda87948cfedbd294f53bf16462e5b57ed3fff0f1 AS runtime
WORKDIR /app
COPY --from=build --chown=bun:bun /app/dist/public-demo.js ./public-demo.js
COPY --from=build --chown=bun:bun /app/apps/web/dist ./web
COPY --chown=bun:bun LICENSE THIRD_PARTY_NOTICES.md ./
USER bun
ENV HOST=0.0.0.0 PORT=3000 STATIC_DIR=/app/web
EXPOSE 3000
CMD ["bun", "public-demo.js"]
